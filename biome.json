{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "files": {
    "includes": ["**/*.{astro,js,jsx,ts,tsx,json,css,scss,md,mdx}"]
  },

  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2
  },

  "css": {
    "parser": {
      "cssModules": true
    }
  },

  "html": {
    "experimentalFullSupportEnabled": true
  },

  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.md", "**/*.mdx"],
      "formatter": {
        "lineWidth": 80 
      }
    }
  ]
}
