---
const { rows = [] } = Astro.props;
---

<table class="data-table">
  <thead>
    <tr>
      <th>Параметр</th>
      <th>Значение</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <td>{row.label}</td>
        <td>{row.value}</td>
      </tr>
    ))}
  </tbody>
</table>

<style is:global>
  .data-table {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: rgba(8, 11, 8, 0.65);
  }

  .data-table th,
  .data-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--sl-color-border);
    text-align: left;
  }

  .data-table th {
    background: rgba(201, 237, 60, 0.08);
    color: var(--sl-color-text-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font: 700 0.68rem var(--sl-font-mono);
  }

  .data-table td {
    color: var(--sl-color-text);
  }
</style>
