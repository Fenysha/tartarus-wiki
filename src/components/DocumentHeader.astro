---
const { security = 'Классификация D', threat = 'Низкая', path = '/docs/', status = 'Открытый архив' } = Astro.props;
---

<div class="doc-header">
  <div class="doc-header-item">
    <span>Уровень секретности</span>
    <strong>{security}</strong>
  </div>
  <div class="doc-header-item">
    <span>Угрозы</span>
    <strong>{threat}</strong>
  </div>
  <div class="doc-header-item">
    <span>Путь</span>
    <strong>{path}</strong>
  </div>
  <div class="doc-header-item">
    <span>Статус</span>
    <strong>{status}</strong>
  </div>
</div>

<style is:global>
  .doc-header {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    margin: 1.25rem 0 2rem;
    padding: 1px;
    background: var(--sl-color-border);
    border: 1px solid var(--sl-color-border);
    border-radius: 0;
  }

  .doc-header-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.8rem 0.9rem;
    background: #171b15;
    border-left: 3px solid var(--sl-color-accent);
  }

  .doc-header-item span {
    font: 700 0.62rem var(--sl-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }

  .doc-header-item strong {
    font: 700 0.9rem var(--sl-font-mono);
  }
</style>
