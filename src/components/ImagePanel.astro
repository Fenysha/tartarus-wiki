---
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  reference?: string;
  source?: string;
}

const {
  src,
  alt = 'Документальное изображение',
  caption = 'Подпись изображения',
  reference = 'IMG-0001',
  source = 'ARCHIVE NODE-01',
} = Astro.props;

// Все изображения из src/assets
const images = import.meta.glob(
  '/src/assets/**/*.{png,jpg,jpeg,webp,gif,avif,svg}',
  {
    eager: true,
    query: '?url',
    import: 'default',
  }
);

// Поиск изображения
let imageSrc = src;

if (src) {
  const normalizedSrc = src
    .replace(/^\/src\/assets\//, '')
    .replace(/^\/+/, '');

  const match = Object.entries(images).find(([path]) => {
    const normalizedPath = path.replace(/^\/src\/assets\//, '');

    return (
      normalizedPath === normalizedSrc ||
      path.endsWith(`/${normalizedSrc}`)
    );
  });

  if (match) {
    imageSrc = match[1] as string;
  }
}

if (!imageSrc) {
  imageSrc = '/placeholder.jpg';
}
---

<figure class="image-panel">
  <div class="image-panel__header">
    <span class="image-panel__type">
      <span
        class="image-panel__indicator"
        aria-hidden="true"
      ></span>

      VISUAL RECORD
    </span>

    <span class="image-panel__reference">
      {reference}
    </span>
  </div>

  <button
    class="image-panel__viewport"
    type="button"
    aria-label={`Открыть изображение: ${alt}`}
  >
    <img
      src={imageSrc}
      alt={alt}
      loading="lazy"
    />

    <div
      class="image-panel__overlay"
      aria-hidden="true"
    >
      <span>ARCHIVE-01</span>
      <span>READ_ONLY</span>
    </div>

    <div
      class="image-panel__corner image-panel__corner--tl"
      aria-hidden="true"
    ></div>

    <div
      class="image-panel__corner image-panel__corner--tr"
      aria-hidden="true"
    ></div>

    <div
      class="image-panel__corner image-panel__corner--bl"
      aria-hidden="true"
    ></div>

    <div
      class="image-panel__corner image-panel__corner--br"
      aria-hidden="true"
    ></div>
  </button>

  <figcaption class="image-panel__caption">
    <span
      class="image-panel__caption-mark"
      aria-hidden="true"
    >
      //
    </span>

    <span class="image-panel__caption-text">
      {caption}
    </span>
  </figcaption>

  <div class="image-panel__footer">
    <span>SOURCE: {source}</span>
    <span>STATUS: VERIFIED</span>
  </div>
</figure>

<dialog class="image-lightbox">
  <div class="image-lightbox__inner">
    <button
      class="image-lightbox__close"
      type="button"
      aria-label="Закрыть изображение"
    >
      ×
    </button>

    <img
      class="image-lightbox__image"
      src={imageSrc}
      alt={alt}
    />

    <div class="image-lightbox__caption">
      {caption}
    </div>
  </div>
</dialog>

<script>
  const panels = document.querySelectorAll('.image-panel');

  panels.forEach((panel) => {
    const viewport = panel.querySelector('.image-panel__viewport');
    const dialog = panel.nextElementSibling;

    if (
      !(viewport instanceof HTMLButtonElement) ||
      !(dialog instanceof HTMLDialogElement)
    ) {
      return;
    }

    const closeButton = dialog.querySelector('.image-lightbox__close');

    const openDialog = () => {
      if (!dialog.open) {
        dialog.showModal();
      }
    };

    const closeDialog = () => {
      if (dialog.open) {
        dialog.close();
      }
    };

    viewport.addEventListener('click', openDialog);

    closeButton?.addEventListener('click', closeDialog);

    // Закрытие при клике именно по backdrop
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        closeDialog();
      }
    });

    // Не даём клику внутри изображения закрывать dialog
    dialog
      .querySelector('.image-lightbox__inner')
      ?.addEventListener('click', (event) => {
        event.stopPropagation();
      });

    // Esc нативно закрывает <dialog> через cancel.
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeDialog();
    });
  });
</script>

<style is:global>
  .image-panel {
    position: relative;
    margin: 1.75rem 0 2rem;
    border: 1px solid var(--sl-color-gray-2);
    background: #0d0d0d;
    font-family: var(--sl-font-mono);
  }

  .image-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.7rem;
    border-bottom: 1px solid var(--sl-color-gray-2);
    background: #111;
    color: var(--sl-color-gray-3);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .image-panel__type {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-text-accent);
  }

  .image-panel__indicator {
    width: 5px;
    height: 5px;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }

  .image-panel__reference {
    opacity: 0.6;
  }

  .image-panel__viewport {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: #080808;
    cursor: zoom-in;
  }

  .image-panel__viewport img {
    display: block;
    width: 100%;
    height: auto;
    filter: none;
    transition:
      transform 300ms ease,
      filter 200ms ease;
  }

  .image-panel__viewport:hover img {
    filter: brightness(1.04);
    transform: scale(1.01);
  }

  .image-panel__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0.6rem 0.7rem;
    pointer-events: none;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
  }

  .image-panel__corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: var(--sl-color-text-accent);
    border-style: solid;
    opacity: 0.75;
    pointer-events: none;
  }

  .image-panel__corner--tl {
    top: 8px;
    left: 8px;
    border-width: 1px 0 0 1px;
  }

  .image-panel__corner--tr {
    top: 8px;
    right: 8px;
    border-width: 1px 1px 0 0;
  }

  .image-panel__corner--bl {
    bottom: 8px;
    left: 8px;
    border-width: 0 0 1px 1px;
  }

  .image-panel__corner--br {
    right: 8px;
    bottom: 8px;
    border-width: 0 1px 1px 0;
  }

  .image-panel__caption {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    padding: 0.7rem 0.8rem 0.45rem;
    color: var(--sl-color-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .image-panel__caption-mark {
    color: var(--sl-color-text-accent);
    opacity: 0.7;
  }

  .image-panel__caption-text {
    text-transform: uppercase;
  }

  .image-panel__footer {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0.8rem 0.55rem;
    color: var(--sl-color-gray-3);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
  }

  /* =========================
     FULLSCREEN IMAGE VIEW
     ========================= */

  .image-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 2rem;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .image-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(3px);
  }

  .image-lightbox__inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  .image-lightbox__image {
    display: block;
    width: auto;
    height: auto;
    max-width: 94vw;
    max-height: 86vh;
    object-fit: contain;
    border: 1px solid var(--sl-color-gray-2);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04),
      0 20px 80px rgba(0, 0, 0, 0.75);
  }

  .image-lightbox__close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    z-index: 2;

    width: 2.25rem;
    height: 2.25rem;
    padding: 0;

    border: 1px solid var(--sl-color-gray-2);
    background: #101010;
    color: var(--sl-color-text);

    font-family: var(--sl-font-mono);
    font-size: 1.5rem;
    line-height: 1;

    cursor: pointer;
  }

  .image-lightbox__close:hover {
    color: var(--sl-color-text-accent);
    background: #181818;
  }

  .image-lightbox__caption {
    max-width: 90vw;
    margin-top: 0.75rem;

    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .image-panel__footer {
      flex-direction: column;
      gap: 0.2rem;
    }

    .image-panel__overlay {
      display: none;
    }

    .image-lightbox {
      padding: 1rem;
    }

    .image-lightbox__image {
      max-width: 96vw;
      max-height: 82vh;
    }

    .image-lightbox__close {
      top: 0;
      right: 0;
    }
  }
</style>