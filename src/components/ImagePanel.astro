---
const { src = '/placeholder.jpg', alt = 'Документальное изображение', caption = 'Подпись изображения' } = Astro.props;
---

<figure class="image-panel">
  <img src={src} alt={alt} />
  <figcaption>{caption}</figcaption>
</figure>

<style is:global>
  .image-panel {
    margin: 1.5rem 0;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  .image-panel img {
    display: block;
    width: 100%;
    filter: grayscale(1) contrast(1.12);
    border: 0;
  }

  .image-panel figcaption {
    margin-top: 0.7rem;
    color: var(--sl-color-gray-2);
    font: 700 0.7rem var(--sl-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
