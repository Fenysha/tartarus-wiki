---
const { title = 'Блок данных', icon = 'document', body = 'Описание блока.' } = Astro.props;
---

<article class="info-card">
  <div class="info-card__icon">{icon}</div>
  <div>
    <h3>{title}</h3>
    <p>{body}</p>
  </div>
</article>

<style is:global>
  .info-card {
    display: flex;
    gap: 1rem;
    padding: 1rem 1.1rem;
    background: rgba(9, 12, 9, 0.68);
    border: 1px solid var(--sl-color-border);
    border-radius: 0;
    box-shadow: inset 3px 0 0 rgba(201, 237, 60, 0.45);
  }

  .info-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0;
    background: rgba(201, 237, 60, 0.12);
    color: var(--sl-color-accent-high);
    font: 700 0.75rem var(--sl-font-mono);
  }

  .info-card h3 {
    margin: 0 0 0.35rem;
    font: 700 0.85rem var(--sl-font-mono);
    color: var(--sl-color-text-accent);
  }

  .info-card p {
    margin: 0;
    color: var(--sl-color-text);
    opacity: 0.9;
  }
</style>
