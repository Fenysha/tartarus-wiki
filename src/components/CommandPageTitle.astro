---
const { entry, id } = Astro.locals.starlightRoute;
const documentPath = `/root/${id || entry.id || 'index'}`.replace(/\/index$/, '');
const checksum = Array.from(documentPath).reduce((sum, character) => (sum + character.charCodeAt(0)) % 65535, 0)
	.toString(16)
	.padStart(4, '0')
	.toUpperCase();
const sectors = Math.max(1, Math.ceil(documentPath.length / 8)).toString().padStart(3, '0');
---

<section
  class="document-command-header__readout"
  aria-label="Технические сведения о документе"
>
  <span aria-hidden="true">root@tartarus:~$</span> man {documentPath}
  <div line-height="1.5" aria-hidden="true">
    <span>NODE: ARCHIVE-01 </span>
    <span>MODE: READ_ONLY </span>
    <span>CRC: {checksum} </span>
    <span>SECTORS: {sectors} </span>
  </div>
</section>
