---
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<aside class="command-sidebar" aria-label="Навигация архива">

  <div class="command-sidebar__status">
    <span class="command-sidebar__signal" aria-hidden="true"></span>
    <span>domain: online</span>
  </div>

  <div class="command-sidebar__terminal" aria-hidden="true">
    <span/>
    <span>ARCHIVE_NODE-01</span>
  </div>

  <div class="command-sidebar__prompt" aria-hidden="true">
    <span class="command-sidebar__prompt-mark">&gt;</span>
    <span>NAVIGATION TREE</span>
  </div>

  <nav
    class="command-sidebar__navigation"
    aria-label="Разделы вики"
  >
    <SidebarPersister>
      <SidebarSublist sublist={sidebar} />
    </SidebarPersister>
  </nav>

  <footer class="command-sidebar__footer">
    <div><span>PROTOCOL</span><strong>TTY/01</strong></div>
    <div><span>CHANNEL</span><strong>LOCALHOST</strong></div>
    <p>
      <span aria-hidden="true">$</span>
      awaiting input_<i aria-hidden="true"></i>
    </p>
  </footer>

</aside>
